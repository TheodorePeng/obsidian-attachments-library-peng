{
  "name": "attachments-library-peng",
  "version": "1.3.0",
  "description": "Vault attachment metadata, reference-aware library and guarded cleanup.",
  "author": "José Compadre Junior",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "pipeline": "npm run lint && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "happy-dom": "21.0.4",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "i18next": "^26.3.3",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.4.168"
  }
}
